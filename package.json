{
  "name": "cadcam",
  "productName": "CADCAM Studio",
  "version": "0.1.0",
  "description": "Modular CAD/CAM workstation",
  "main": "./out/main/index.js",
  "author": "MattyJamesClark",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --config electron-builder.config.cjs --publish never",
    "release": "npm run dist",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "rhino3dm": "^8.17.0",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
